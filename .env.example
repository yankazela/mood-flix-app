# ─── AWS Cognito (user pool + Google federation) ─────────────────────────────
# Copy to .env.local and fill in. These identify a PUBLIC app client and are
# inlined into the browser bundle at build time; they are not secrets.
# Leave the pool ID / client ID empty to run with the built-in mock auth.

# Cognito console → User pools → <pool> → Overview
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# App integration → App clients → <client>  (must be a client WITHOUT a secret)
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Needed for "Continue with Google". App integration → Domain,
# e.g. moodflix.auth.ca-central-1.amazoncognito.com  (no https://)
NEXT_PUBLIC_COGNITO_DOMAIN=

# Optional. Defaults to <current origin>/auth/callback and <current origin>/login.
# Each value must also be listed in the app client's allowed callback / sign-out URLs.
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=

# ─── MoodFlix API ────────────────────────────────────────────────────────────
# Base URL of the API Gateway stage, ending in /api/v1/movie-mood (no trailing slash).
# Defaults to the `dev` stage deployed from ../MovieMood.
NEXT_PUBLIC_API_BASE_URL=https://mobgc8hyw7.execute-api.us-east-1.amazonaws.com/dev/api/v1/movie-mood

# Public base URL of the catalogue bucket (the `PostersBaseUrl` output of the storage stack).
# A poster's URL is this base plus the item's posterKey, e.g. posters/tmdb-movie-508442.jpg.
NEXT_PUBLIC_POSTERS_BASE_URL=https://movie-mood-storage-dev.s3.us-east-1.amazonaws.com

# ─── Subscriptions (RevenueCat) ──────────────────────────────────────────────
# Public SDK keys from the RevenueCat project (Project settings → API keys). Used by the iOS and
# Android builds only; leave them empty for the web, where the paywall points people to the apps.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# The entitlement that unlocks Advanced. Must match the backend's REVENUECAT_ENTITLEMENT_ID.
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT=advanced
# Legal links on the paywall. Apple requires both; the Terms default is Apple's standard EULA.
NEXT_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
NEXT_PUBLIC_PRIVACY_URL=
# Shown where the store price cannot be read (the web). Native screens show the store's own price.
NEXT_PUBLIC_ADVANCED_PRICE_LABEL=US$3.99 / month
